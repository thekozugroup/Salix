#!/usr/bin/env python3
"""Unified Salix CLI.

Subcommands:
    salix status                       — quick state report
    salix profiles                     — list saved benchmarks
    salix init [--scope global|project] — create profile store folders
    salix ingest [--name N] [--samples DIR]
    salix analyze FILE
    salix compare FILE [--profile N]
    salix gap FILE [--profile N]       — alias: compare + visualize the report
    salix simulate FILE [--profile N]
    salix benchmark [--profile N]      — print benchmark visualization
    salix help

The default profile is "default". Run `salix status` first if unsure.
Use `--scope global` for ~/.salix or `--scope project` for .salix in the
current project. `--scope auto` prefers project, then global.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import shlex
import sys
from pathlib import Path

__version__ = "0.10.0"

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / "scripts"))

from lib.distance import EXPECTED_SIGMA, SKIP_FEATURES, compute_gaps  # noqa: E402
from lib.io_utils import load_json, load_text  # noqa: E402
from lib.stats import analyze  # noqa: E402

# SALIX_HOME points to where benchmarks/ and samples/ live. It is resolved
# at runtime from explicit flags, legacy env vars, and global/project scope.
SALIX_HOME = Path(os.environ.get("SALIX_HOME", str(ROOT)))
BENCH_DIR = SALIX_HOME / "benchmarks"
SAMPLES_DIR = SALIX_HOME / "samples"
ACTIVE_SCOPE = "install"


def _global_home() -> Path:
    return Path(os.environ.get("SALIX_GLOBAL_HOME", str(Path.home() / ".salix"))).expanduser()


def _project_home(project_dir: str | None = None) -> Path:
    base = Path(project_dir).expanduser() if project_dir else Path.cwd()
    base = base.resolve()
    for candidate in [base] + list(base.parents):
        salix_dir = candidate / ".salix"
        if salix_dir.exists():
            return salix_dir
        if any((candidate / marker).exists() for marker in [".git", "pyproject.toml", "package.json", "Cargo.toml"]):
            return salix_dir
    return base / ".salix"


def _has_local_state(home: Path) -> bool:
    return (home / "benchmarks").exists() or (home / "samples").exists()


def _resolve_home(
    scope: str | None = None,
    home: str | None = None,
    project_dir: str | None = None,
) -> tuple[Path, str]:
    """Resolve the active profile store.

    Precedence:
      1. --home PATH
      2. SALIX_HOME (legacy single-store mode)
      3. --scope / SALIX_SCOPE
      4. auto: project .salix if present, else global ~/.salix
    """
    if home:
        return Path(home).expanduser().resolve(), "custom"

    if os.environ.get("SALIX_HOME"):
        return Path(os.environ["SALIX_HOME"]).expanduser().resolve(), "env"

    selected = scope or os.environ.get("SALIX_SCOPE", "auto")
    if selected == "global":
        return _global_home().resolve(), "global"
    if selected == "project":
        return _project_home(project_dir), "project"
    if selected == "install":
        return ROOT, "install"
    if selected != "auto":
        raise SystemExit(f"Unknown scope '{selected}'. Use auto, global, project, or install.")

    project = _project_home(project_dir)
    if _has_local_state(project):
        return project, "project"
    global_home = _global_home()
    if _has_local_state(global_home):
        return global_home.resolve(), "global"
    return global_home.resolve(), "global"


def _configure_home(args) -> None:
    global SALIX_HOME, BENCH_DIR, SAMPLES_DIR, ACTIVE_SCOPE
    SALIX_HOME, ACTIVE_SCOPE = _resolve_home(
        getattr(args, "scope", None),
        getattr(args, "home", None),
        getattr(args, "project_dir", None),
    )
    selected = getattr(args, "scope", None) or os.environ.get("SALIX_SCOPE", "auto")
    profile = getattr(args, "profile", None)
    if (selected == "auto" and ACTIVE_SCOPE == "project" and profile
            and not getattr(args, "home", None) and not os.environ.get("SALIX_HOME")
            and not (SALIX_HOME / "benchmarks" / f"{profile}.json").exists()
            and (_global_home() / "benchmarks" / f"{profile}.json").is_file()):
        SALIX_HOME, ACTIVE_SCOPE = _global_home().resolve(), "global"
    BENCH_DIR = SALIX_HOME / "benchmarks"
    SAMPLES_DIR = SALIX_HOME / "samples"


def _add_scope_flags(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--scope",
        choices=["auto", "global", "project", "install"],
        default=None,
        help="Profile store to use: auto, global (~/.salix), project (.salix), or explicit install dir",
    )
    parser.add_argument("--home", help="Custom Salix home directory (overrides scope)")
    parser.add_argument("--project-dir", help="Project directory for --scope project/auto")


def _bench_path(name: str) -> Path:
    if not name or name in {".", ".."} or "/" in name or "\\" in name:
        raise SystemExit("Profile names may only be simple names like 'default' or 'client-a'.")
    return BENCH_DIR / f"{name}.json"


def _command_example(*arguments: str) -> str:
    return shlex.join([sys.executable, str(ROOT / "salix"), *arguments, "--home", str(SALIX_HOME)])


# Latest benchmark schema version we read. Older files emit a clear error.
SCHEMA_VERSION = 2


def _load_bench(name: str) -> dict:
    """Load a benchmark JSON, with a small retry on JSONDecodeError to ride
    out concurrent writes (atomic os.replace makes torn writes impossible,
    but a competing reader can still observe the moment between unlink and
    replace on some filesystems). Validates schema_version."""
    import time
    p = _bench_path(name)
    if not p.exists():
        raise SystemExit(
            f"No benchmark named '{name}' at {p}.\n"
            f"Run `{_command_example('ingest', '--name', name)}` after adding samples to {SAMPLES_DIR}/"
        )
    last_err = None
    for attempt in range(3):
        try:
            data = load_json(p)
            break
        except json.JSONDecodeError as e:
            last_err = e
            time.sleep(0.05 * (attempt + 1))
    else:
        raise SystemExit(
            f"Benchmark {p} could not be decoded after 3 attempts: {last_err}.\n"
            "If this is a malformed file, re-run `salix ingest`."
        )
    if not isinstance(data, dict):
        raise ValueError(f"Benchmark {p} must be a JSON object. Rebuild with salix ingest.")
    sv = data.get("schema_version", 1)
    if not isinstance(sv, int) or isinstance(sv, bool) or sv < 1:
        raise ValueError(f"Benchmark {p} has an invalid schema version.")
    stats = data.get("stats", data)
    if not isinstance(stats, dict) or not any(k in stats for k in ("ttr", "mean_sent_len")):
        raise ValueError(f"Benchmark {p} has no style statistics. Rebuild with salix ingest.")
    def number(value, limit=1_000_000_000):
        try:
            return (isinstance(value, (int, float)) and not isinstance(value, bool)
                    and math.isfinite(value) and abs(value) <= limit)
        except OverflowError:
            return False

    list_features = {"fw_bigrams", "fw_trigrams", "sentence_starters", "char_3grams",
                     "char_4grams", "pos_bigrams", "pos_trigrams", "mfw_top150"}
    ratio_features = {"ttr", "long_word_ratio", "short_sent_ratio", "long_sent_ratio", "simpson_d"}
    for key, value in stats.items():
        if key in {"_sigma", "_mfw_sigma", "_pos_sigma"}:
            valid = (isinstance(value, dict) and all(
                isinstance(k, str) and number(v) and v >= 0 for k, v in value.items()))
        elif key in list_features:
            valid = isinstance(value, list) and all(
                isinstance(pair, (list, tuple)) and len(pair) == 2
                and isinstance(pair[0], str) and number(pair[1], 1000 if key == "mfw_top150" else 1)
                and pair[1] >= 0
                for pair in value)
        elif key in ratio_features:
            valid = number(value, 1) and value >= 0
        elif key == "sentiment_polarity":
            valid = number(value, 1)
        elif key in EXPECTED_SIGMA or key in SKIP_FEATURES or key.endswith("_per1k"):
            valid = number(value)
        else:
            valid = not isinstance(value, (int, float)) or number(value)
        if not valid:
            raise ValueError(f"Benchmark {p} has invalid statistics for {key}. Rebuild with salix ingest.")
    if sv > SCHEMA_VERSION:
        raise SystemExit(
            f"Benchmark {p} declares schema_version={sv} but this CLI only "
            f"supports up to {SCHEMA_VERSION}. Upgrade Salix or use a newer "
            "benchmark format."
        )
    if sv < SCHEMA_VERSION:
        # v1 benchmarks lack `_sigma` and `_mfw_sigma`. They still load — the
        # distance code falls back to EXPECTED_SIGMA priors — but warn so the
        # user knows to re-ingest for full fidelity.
        import warnings
        warnings.warn(
            f"Benchmark {p} is schema_version={sv} (current is {SCHEMA_VERSION}). "
            "Empirical sigma is unavailable; consider re-ingesting samples.",
            stacklevel=2,
        )
    return data


def _list_profiles() -> list[str]:
    if not BENCH_DIR.exists():
        return []
    return sorted(p.stem for p in BENCH_DIR.glob("*.json"))


def _sample_file_count(limit: int = 1000) -> str:
    if not SAMPLES_DIR.exists():
        return "0"
    count = 0
    for pattern in ("*.txt", "*.md"):
        for _path in SAMPLES_DIR.rglob(pattern):
            count += 1
            if count >= limit:
                return f"{limit}+"
    return str(count)


def cmd_status(args):
    profiles = _list_profiles()
    if getattr(args, "json", False):
        print(json.dumps({
            "version": __version__, "root": str(ROOT), "home": str(SALIX_HOME),
            "scope": ACTIVE_SCOPE, "profiles": profiles, "sample_files": _sample_file_count(),
            "project_home": str(_project_home(getattr(args, "project_dir", None))),
            "global_home": str(_global_home().resolve()),
            "next_step": "compare" if profiles else "ingest",
        }))
        return 0
    print(f"Salix root:       {ROOT}")
    print(f"SALIX_HOME:       {SALIX_HOME}")
    print(f"Scope:            {ACTIVE_SCOPE}")
    print(f"Project home:     {_project_home(getattr(args, 'project_dir', None))}")
    print(f"Global home:      {_global_home().resolve()}")
    print("Auto order:       project -> global")
    print(f"Version:          {__version__}")
    print(f"Profiles:         {len(profiles)}  ({', '.join(profiles) if profiles else 'none'})")
    print(f"Sample files:     {_sample_file_count()}")
    if profiles:
        for name in profiles:
            try:
                data = _load_bench(name)
            except (SystemExit, OSError, ValueError, KeyError) as e:
                print(f"  - {name:20} <unreadable: {type(e).__name__}: {e}>")
                continue
            stats = data.get("stats", {})
            print(f"  - {name:20} {stats.get('total_word_count', 0):>7,} words from "
                  f"{stats.get('sample_count', '?')} samples (created {data.get('created_at', '?')})")
    if not profiles:
        print("\nNo style profile found.")
        print("\nNext steps:")
        print(f"  1. Add .txt or .md writing samples to {SAMPLES_DIR}/")
        print("  2. Build your profile:")
        print(f"     {_command_example('ingest', '--name', 'default')}")
        print("  3. Check it:")
        print(f"     {_command_example('benchmark', '--profile', 'default')}")
        print("\nTip: 3,000+ words is good. 10,000+ is better.")
    return 0


def cmd_profiles(args):
    for name in _list_profiles():
        print(name)
    return 0


def cmd_init(args):
    BENCH_DIR.mkdir(parents=True, exist_ok=True)
    SAMPLES_DIR.mkdir(parents=True, exist_ok=True)
    if ACTIVE_SCOPE == "project":
        gitignore = SALIX_HOME / ".gitignore"
        if not gitignore.exists():
            gitignore.write_text("*\n!.gitignore\n")
    print("Salix profile store ready.")
    print(f"Scope:            {ACTIVE_SCOPE}")
    print(f"SALIX_HOME:       {SALIX_HOME}")
    print(f"Samples:          {SAMPLES_DIR}")
    print(f"Benchmarks:       {BENCH_DIR}")
    print("\nNext:")
    print(f"  1. Put .txt or .md writing samples in {SAMPLES_DIR}/")
    print(f"  2. Run: {_command_example('ingest', '--name', 'default')}")
    return 0


def cmd_setup(args):
    cmd_init(args)
    if args.samples:
        return cmd_ingest(args)
    return 0


def cmd_doctor(args):
    from lib.package_files import package_files
    checks = []
    try:
        package_files(ROOT)
        checks.append({"name": "runtime", "status": "ok", "detail": "All runtime files present"})
    except ValueError as exc:
        checks.append({"name": "runtime", "status": "error", "detail": str(exc)})
    for name in _list_profiles():
        try:
            _load_bench(name)
            checks.append({"name": f"profile:{name}", "status": "ok", "detail": "Readable style profile"})
        except (SystemExit, OSError, ValueError) as exc:
            checks.append({"name": f"profile:{name}", "status": "error", "detail": str(exc)})
    if not _list_profiles():
        checks.append({"name": "profiles", "status": "action", "detail": "Add writing samples, then run salix setup --samples PATH"})
    ok = all(check["status"] != "error" for check in checks)
    result = {"ok": ok, "version": __version__, "python": sys.version.split()[0],
              "scope": ACTIVE_SCOPE, "home": str(SALIX_HOME), "checks": checks}
    if args.json:
        print(json.dumps(result))
    else:
        print(f"Salix {__version__} | Python {result['python']} | {ACTIVE_SCOPE}")
        for check in checks:
            print(f"  {check['status']}: {check['name']} - {check['detail']}")
    return 0 if ok else 1


def cmd_hooks(args):
    path = SALIX_HOME / "config.json"
    config = load_json(path, max_bytes=65536) if path.is_file() else {}
    if not isinstance(config, dict):
        raise ValueError(f"Invalid configuration: {path}")
    if args.action != "status":
        BENCH_DIR.mkdir(parents=True, exist_ok=True)
        SAMPLES_DIR.mkdir(parents=True, exist_ok=True)
        if ACTIVE_SCOPE == "project" and not (SALIX_HOME / ".gitignore").exists():
            (SALIX_HOME / ".gitignore").write_text("*\n!.gitignore\n")
        config["hooks_enabled"] = args.action == "enable"
        import tempfile
        fd, temporary = tempfile.mkstemp(prefix=".config-", dir=SALIX_HOME)
        try:
            with os.fdopen(fd, "w") as handle:
                json.dump(config, handle, indent=2)
                handle.write("\n")
            os.replace(temporary, path)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
    saved = config.get("hooks_enabled") is True
    override = os.environ.get("SALIX_HOOKS")
    print(json.dumps({"hooks_enabled": saved,
                      "effective_enabled": override == "1" if override is not None else saved,
                      "scope": ACTIVE_SCOPE, "config": str(path)}))
    return 0


def cmd_ingest(args):
    from scripts.ingest import main as ingest_main  # type: ignore
    samples = args.samples or str(SAMPLES_DIR)
    out = _bench_path(args.name)
    sys.argv = ["ingest.py", "--samples", samples, "--out", str(out),
                "--name", args.name, "--min-words", str(args.min_words)]
    return ingest_main()


def cmd_analyze(args):
    text = load_text(Path(args.path))
    stats = analyze(text)
    if args.json:
        json.dump(stats, sys.stdout, indent=2 if args.pretty else None)
        sys.stdout.write("\n")
    else:
        from scripts.visualize import render_stats  # type: ignore
        print(render_stats(stats, header="TARGET STATS"))
    return 0


def cmd_compare(args):
    text = load_text(Path(args.path))
    target = analyze(text)
    bench = _load_bench(args.profile)
    bench_stats = bench.get("stats", bench)
    report = compute_gaps(target, bench_stats)
    report["profile"] = args.profile
    report["profile_home"] = str(SALIX_HOME)
    report["scope"] = ACTIVE_SCOPE
    if args.json:
        print(json.dumps(report, indent=2 if args.pretty else None, allow_nan=False))
    else:
        from scripts.visualize import render_gap  # type: ignore
        print(render_gap(report))
    return 0


def cmd_gap(args):
    args.json = False
    return cmd_compare(args)


def cmd_benchmark(args):
    bench = _load_bench(args.profile)
    from scripts.visualize import render_stats  # type: ignore
    name = bench.get("name", args.profile)
    s = bench.get("stats", bench)
    print(f"\nBenchmark '{name}'  ({s.get('total_word_count', 0):,} words from "
          f"{s.get('sample_count', '?')} samples)")
    print(render_stats(s, header=f"BENCHMARK '{name}'"))
    return 0


def cmd_validate(args):
    from scripts.validate import (  # type: ignore
        attribution_check,
        attribution_check_real,
        cross_domain_check,
        render_report,
        stability_check,
        topic_transfer_check,
    )
    if getattr(args, "cross_domain", None):
        print(f"Running cross-domain check on: {args.cross_domain}")
        result = cross_domain_check(Path(args.cross_domain))
        print(f"\nAuthors:                          {result['authors']}")
        print(f"Mean same-author cross-domain:    {result['mean_same_author_cross_domain']:.3f}")
        print(f"Mean other-author cross-domain:   {result['mean_other_author_cross_domain']:.3f}")
        print(f"Separation ratio:                 {result['separation_ratio']:.2f}× "
              "(>1 means same-author docs cluster closer across domains)")
        return 0
    if getattr(args, "corpus_dir", None):
        print(f"Running attribution check on real corpus: {args.corpus_dir}")
        attr = attribution_check_real(Path(args.corpus_dir))
    else:
        print("Running attribution check (synthetic — see docstring on circularity)...")
        attr = attribution_check(args.authors, args.docs_per_author, args.seed,
                                 args.sentences_per_doc)
    print("Running topic-transfer check...")
    tt = topic_transfer_check(args.authors, args.seed, args.sentences_per_doc)
    print("Running stability check...")
    stab = stability_check(args.seed, args.sentences_per_doc)
    report = render_report(attr, tt, stab)
    print()
    print(report)
    if args.out:
        Path(args.out).parent.mkdir(parents=True, exist_ok=True)
        Path(args.out).write_text(report)
        print(f"Report written to {args.out}")
    return 0


def cmd_baseline(args):
    """Run the Stamatatos (2009) char-3gram + cosine baseline on a corpus
    for head-to-head comparison against Salix's full-feature distance."""
    from scripts.stamatatos_baseline import attribute as _baseline  # type: ignore
    res = _baseline(Path(args.corpus_dir), args.top_k)
    print(f"Method:          {res['method']}")
    print(f"Vocabulary size: {res['top_k']}")
    print(f"Authors:         {res['authors']}")
    print(f"Held-out docs:   {res['total_held_out']}")
    print(f"Correct:         {res['correct']}")
    print(f"Accuracy:        {res['accuracy']:.1%}")
    return 0


def cmd_simulate(args):
    from scripts.simulate_loop import run_loop  # type: ignore
    bench = _load_bench(args.profile)
    bench_stats = bench.get("stats", bench)
    text = load_text(Path(args.path))
    import random
    random.seed(args.seed)
    if args.json and args.verbose:
        from contextlib import redirect_stdout
        with redirect_stdout(sys.stderr):
            result = run_loop(text, bench_stats, args.max_iter, args.threshold, verbose=True)
    else:
        result = run_loop(text, bench_stats, args.max_iter, args.threshold, verbose=args.verbose)
    if args.out:
        Path(args.out).write_text(result["final_text"])
    if args.json:
        json.dump(result, sys.stdout, indent=2 if args.pretty else None)
        sys.stdout.write("\n")
        return 0
    print(f"\nStop reason: {result['stop_reason']}")
    print(f"Accepted edits: {max(len(result['history']) - 1, 0)}")
    print("Distance trajectory:", " -> ".join(f"{h['distance']:.3f}" for h in result["history"]))
    from scripts.visualize import render_convergence  # type: ignore
    print(render_convergence(result["history"]))
    if args.out:
        print(f"Final text written to {args.out}")
    return 0


def cmd_help(args):
    print(__doc__)
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="salix", description="Personal writing-style replicator.")
    p.add_argument("--version", action="version", version=f"salix {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)

    p_status = sub.add_parser("status", help="Show profiles, samples, and next-step suggestions")
    p_status.add_argument("--json", action="store_true")
    _add_scope_flags(p_status)
    p_status.set_defaults(fn=cmd_status)

    p_profiles = sub.add_parser("profiles", help="List saved benchmarks")
    _add_scope_flags(p_profiles)
    p_profiles.set_defaults(fn=cmd_profiles)

    p_init = sub.add_parser("init", help="Create a global or project Salix profile store")
    _add_scope_flags(p_init)
    p_init.set_defaults(fn=cmd_init)

    p_setup = sub.add_parser("setup", help="Create a style store and optionally build its profile")
    _add_scope_flags(p_setup)
    p_setup.add_argument("--samples", help="Folder of existing .txt/.md writing samples")
    p_setup.add_argument("--name", default="default")
    p_setup.add_argument("--min-words", type=int, default=300)
    p_setup.set_defaults(fn=cmd_setup)

    p_doctor = sub.add_parser("doctor", help="Check runtime and profile health")
    _add_scope_flags(p_doctor)
    p_doctor.add_argument("--json", action="store_true")
    p_doctor.set_defaults(fn=cmd_doctor)

    p_hooks = sub.add_parser("hooks", help="Enable or disable plugin session context")
    _add_scope_flags(p_hooks)
    p_hooks.add_argument("action", choices=["enable", "disable", "status"])
    p_hooks.set_defaults(fn=cmd_hooks)

    sub.add_parser("help", help="Show full CLI help").set_defaults(fn=cmd_help)

    p_ing = sub.add_parser("ingest", help="Build a benchmark from samples")
    p_ing.add_argument("--name", default="default")
    p_ing.add_argument("--samples", help=f"Sample directory (default: {SAMPLES_DIR})")
    p_ing.add_argument("--min-words", type=int, default=300)
    _add_scope_flags(p_ing)
    p_ing.set_defaults(fn=cmd_ingest)

    p_an = sub.add_parser("analyze", help="Analyze a single file")
    p_an.add_argument("path")
    p_an.add_argument("--json", action="store_true")
    p_an.add_argument("--pretty", action="store_true")
    p_an.set_defaults(fn=cmd_analyze)

    p_cmp = sub.add_parser("compare", help="Compare a file against a benchmark")
    p_cmp.add_argument("path")
    p_cmp.add_argument("--profile", default="default")
    p_cmp.add_argument("--json", action="store_true")
    p_cmp.add_argument("--pretty", action="store_true")
    _add_scope_flags(p_cmp)
    p_cmp.set_defaults(fn=cmd_compare)

    p_gap = sub.add_parser("gap", help="Show gap report for a file (visualized)")
    p_gap.add_argument("path")
    p_gap.add_argument("--profile", default="default")
    p_gap.add_argument("--pretty", action="store_true")
    _add_scope_flags(p_gap)
    p_gap.set_defaults(fn=cmd_gap)

    p_b = sub.add_parser("benchmark", help="Visualize a saved benchmark")
    p_b.add_argument("--profile", default="default")
    _add_scope_flags(p_b)
    p_b.set_defaults(fn=cmd_benchmark)

    p_val = sub.add_parser("validate", help="Run the empirical validation harness")
    p_val.add_argument("--seed", type=int, default=0)
    p_val.add_argument("--authors", type=int, default=5)
    p_val.add_argument("--docs-per-author", type=int, default=6)
    p_val.add_argument("--sentences-per-doc", type=int, default=60)
    p_val.add_argument("--corpus-dir", help="Real-corpus dir (subdirs are authors)")
    p_val.add_argument("--cross-domain", help="Run cross-domain stability check on a real corpus")
    p_val.add_argument("--out", help="Path to save the report")
    p_val.set_defaults(fn=cmd_validate)

    p_bl = sub.add_parser("baseline", help="Run Stamatatos 2009 char-3gram + cosine baseline")
    p_bl.add_argument("--corpus-dir", required=True)
    p_bl.add_argument("--top-k", type=int, default=1000)
    p_bl.set_defaults(fn=cmd_baseline)

    p_sim = sub.add_parser("simulate", help="Dry-run rewrite loop with rule-based edits")
    p_sim.add_argument("path")
    p_sim.add_argument("--profile", default="default")
    p_sim.add_argument("--max-iter", type=int, default=10)
    p_sim.add_argument("--threshold", type=float, default=0.15)
    p_sim.add_argument("--seed", type=int, default=0)
    p_sim.add_argument("--verbose", action="store_true")
    p_sim.add_argument("--out")
    p_sim.add_argument("--json", action="store_true")
    p_sim.add_argument("--pretty", action="store_true")
    _add_scope_flags(p_sim)
    p_sim.set_defaults(fn=cmd_simulate)

    return p


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        _configure_home(args)
        return args.fn(args)
    except (OSError, ValueError, TypeError, OverflowError, RecursionError) as exc:
        print(f"Salix error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
