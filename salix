#!/usr/bin/env python3
"""Unified Salix CLI.

Subcommands:
    salix status                       — quick state report
    salix profiles                     — list saved benchmarks
    salix ingest [--name N] [--samples DIR]
    salix analyze FILE
    salix compare FILE [--profile N]
    salix gap FILE [--profile N]       — alias: compare + visualize the report
    salix simulate FILE [--profile N]
    salix benchmark [--profile N]      — print benchmark visualization
    salix help

The default profile is "default". Run `salix status` first if unsure.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

__version__ = "0.7.0"

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
sys.path.insert(0, str(ROOT / "scripts"))

from lib.distance import compute_gaps  # noqa: E402
from lib.io_utils import load_text  # noqa: E402
from lib.stats import analyze, aggregate  # noqa: E402

# SALIX_HOME points to where benchmarks/ and samples/ live. Defaults to the
# script's own directory (the dev/install path). Tests and multi-user
# deployments should override it to keep state isolated from the install dir.
SALIX_HOME = Path(os.environ.get("SALIX_HOME", str(ROOT)))
BENCH_DIR = SALIX_HOME / "benchmarks"
SAMPLES_DIR = SALIX_HOME / "samples"


def _bench_path(name: str) -> Path:
    return BENCH_DIR / f"{name}.json"


def _load_bench(name: str) -> dict:
    p = _bench_path(name)
    if not p.exists():
        raise SystemExit(
            f"No benchmark named '{name}' at {p}.\n"
            f"Run `salix ingest --name {name}` after dropping samples in {SAMPLES_DIR}/"
        )
    return json.loads(p.read_text())


def _list_profiles() -> list[str]:
    if not BENCH_DIR.exists():
        return []
    return sorted(p.stem for p in BENCH_DIR.glob("*.json"))


def cmd_status(args):
    profiles = _list_profiles()
    sample_files = sorted(list(SAMPLES_DIR.rglob("*.txt")) + list(SAMPLES_DIR.rglob("*.md"))) if SAMPLES_DIR.exists() else []
    print(f"Salix root:       {ROOT}")
    print(f"SALIX_HOME:       {SALIX_HOME}")
    print(f"Version:          {__version__}")
    print(f"Profiles:         {len(profiles)}  ({', '.join(profiles) if profiles else 'none'})")
    print(f"Sample files:     {len(sample_files)}")
    if profiles:
        for name in profiles:
            data = json.loads(_bench_path(name).read_text())
            stats = data.get("stats", {})
            print(f"  - {name:20} {stats.get('total_word_count', 0):>7,} words from "
                  f"{stats.get('sample_count', '?')} samples (created {data.get('created_at', '?')})")
    if not profiles:
        print("\nNext step: drop writing samples in samples/ then run `salix ingest`.")
    return 0


def cmd_profiles(args):
    for name in _list_profiles():
        print(name)
    return 0


def cmd_ingest(args):
    from scripts.ingest import main as ingest_main  # type: ignore
    samples = args.samples or str(SAMPLES_DIR)
    out = _bench_path(args.name)
    sys.argv = ["ingest.py", "--samples", samples, "--out", str(out),
                "--name", args.name, "--min-words", str(args.min_words)]
    return ingest_main()


def cmd_analyze(args):
    text = load_text(Path(args.path))
    stats = analyze(text)
    if args.json:
        json.dump(stats, sys.stdout, indent=2 if args.pretty else None)
        sys.stdout.write("\n")
    else:
        from scripts.visualize import render_stats  # type: ignore
        print(render_stats(stats, header="TARGET STATS"))
    return 0


def cmd_compare(args):
    text = load_text(Path(args.path))
    target = analyze(text)
    bench = _load_bench(args.profile)
    bench_stats = bench.get("stats", bench)
    report = compute_gaps(target, bench_stats)
    if args.json:
        json.dump(report, sys.stdout, indent=2 if args.pretty else None)
        sys.stdout.write("\n")
    else:
        from scripts.visualize import render_gap  # type: ignore
        print(render_gap(report))
    return 0


def cmd_gap(args):
    args.json = False
    return cmd_compare(args)


def cmd_benchmark(args):
    bench = _load_bench(args.profile)
    from scripts.visualize import render_stats  # type: ignore
    name = bench.get("name", args.profile)
    s = bench.get("stats", bench)
    print(f"\nBenchmark '{name}'  ({s.get('total_word_count', 0):,} words from "
          f"{s.get('sample_count', '?')} samples)")
    print(render_stats(s, header=f"BENCHMARK '{name}'"))
    return 0


def cmd_simulate(args):
    from scripts.simulate_loop import run_loop  # type: ignore
    bench = _load_bench(args.profile)
    bench_stats = bench.get("stats", bench)
    text = load_text(Path(args.path))
    import random
    random.seed(args.seed)
    result = run_loop(text, bench_stats, args.max_iter, args.threshold, verbose=args.verbose)
    print(f"\nStop reason: {result['stop_reason']}")
    print(f"Iterations:  {len(result['history'])}")
    print("Distance trajectory:", " → ".join(f"{h['distance']:.3f}" for h in result["history"]))
    if args.out:
        Path(args.out).write_text(result["final_text"])
        print(f"Final text written to {args.out}")
    return 0


def cmd_help(args):
    print(__doc__)
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="salix", description="Personal writing-style replicator.")
    p.add_argument("--version", action="version", version=f"salix {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status", help="Show profiles, samples, and next-step suggestions").set_defaults(fn=cmd_status)
    sub.add_parser("profiles", help="List saved benchmarks").set_defaults(fn=cmd_profiles)
    sub.add_parser("help", help="Show full CLI help").set_defaults(fn=cmd_help)

    p_ing = sub.add_parser("ingest", help="Build a benchmark from samples")
    p_ing.add_argument("--name", default="default")
    p_ing.add_argument("--samples", help=f"Sample directory (default: {SAMPLES_DIR})")
    p_ing.add_argument("--min-words", type=int, default=300)
    p_ing.set_defaults(fn=cmd_ingest)

    p_an = sub.add_parser("analyze", help="Analyze a single file")
    p_an.add_argument("path")
    p_an.add_argument("--json", action="store_true")
    p_an.add_argument("--pretty", action="store_true")
    p_an.set_defaults(fn=cmd_analyze)

    p_cmp = sub.add_parser("compare", help="Compare a file against a benchmark")
    p_cmp.add_argument("path")
    p_cmp.add_argument("--profile", default="default")
    p_cmp.add_argument("--json", action="store_true")
    p_cmp.add_argument("--pretty", action="store_true")
    p_cmp.set_defaults(fn=cmd_compare)

    p_gap = sub.add_parser("gap", help="Show gap report for a file (visualized)")
    p_gap.add_argument("path")
    p_gap.add_argument("--profile", default="default")
    p_gap.add_argument("--pretty", action="store_true")
    p_gap.set_defaults(fn=cmd_gap)

    p_b = sub.add_parser("benchmark", help="Visualize a saved benchmark")
    p_b.add_argument("--profile", default="default")
    p_b.set_defaults(fn=cmd_benchmark)

    p_sim = sub.add_parser("simulate", help="Dry-run rewrite loop with rule-based edits")
    p_sim.add_argument("path")
    p_sim.add_argument("--profile", default="default")
    p_sim.add_argument("--max-iter", type=int, default=10)
    p_sim.add_argument("--threshold", type=float, default=0.15)
    p_sim.add_argument("--seed", type=int, default=0)
    p_sim.add_argument("--verbose", action="store_true")
    p_sim.add_argument("--out")
    p_sim.set_defaults(fn=cmd_simulate)

    return p


def main(argv=None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    raise SystemExit(main())
